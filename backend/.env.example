# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Required: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-hex-from-secrets-token-hex-32

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (defaults to local SQLite; replace with PostgreSQL URL in production)
# PostgreSQL example: postgresql://user:password@localhost:5432/petcompany
DATABASE_URL=sqlite:///./petcompany.db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500"]
